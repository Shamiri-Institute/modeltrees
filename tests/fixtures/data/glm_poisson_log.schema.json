{
  "dataset": "glm_poisson_log",
  "description": "Counts, log link, moderate mean.",
  "source": "simulated",
  "seed": 20261018,
  "rng_kind": ["Mersenne-Twister", "Inversion", "Rejection"],
  "n": 200,
  "csv": "glm_poisson_log.csv",
  "columns": [
    {
      "name": "x0",
      "type": "double"
    },
    {
      "name": "x1",
      "type": "double"
    },
    {
      "name": "x2",
      "type": "double"
    },
    {
      "name": "y",
      "type": "integer"
    }
  ],
  "generator_code": "{\n    n <- 200L\n    d <- data.frame(x0 = 1, x1 = rnorm(n), x2 = runif(n))\n    d$y <- rpois(n, exp(0.5 + 0.4 * d$x1 + 0.6 * d$x2))\n    d\n}"
}
